<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
    </handlers>
    <!-- Change the arguments path to match your actual build output path (e.g., bin\Debug\net10.0\Alphabet.AppWire.dll) -->
    <aspNetCore processPath="dotnet" arguments=".\bin\Debug\net10.0\Alphabet.AppWire.dll" stdoutLogEnabled="false" hostingModel="inprocess" />
  </system.webServer>
</configuration>
